# ScholarAgent environment template.
#
#   cp .env.example .env
#
# Then fill in the values below. .env is gitignored; never commit real
# credentials.

# --- Google Gemini (required) ---
# Used by the manager, the generator, and the text-to-Cypher tool.
# Create a key at https://aistudio.google.com/apikey
# The models pinned in configs/settings.py require a project with billing
# enabled; free-tier keys may only have quota for older models.
GOOGLE_API_KEY=

# --- Neo4j (required for the knowledge-graph route) ---
# The vector-retrieval route works without these. If Neo4j is unreachable,
# the agent classifies the knowledge-graph route as failed and falls back to
# vector retrieval rather than erroring out.
#
# Local instance via Docker:
#   docker run --rm -p 7474:7474 -p 7687:7687 \
#     -e NEO4J_AUTH=neo4j/your_password neo4j:5
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# --- Semantic Scholar (required only for the graph build) ---
# Used by src/data_processing/fetch_s2_metadata.py to enrich arXiv papers with
# citation and author data before populating Neo4j. That script raises if this
# is unset. Not needed to run the agent or the vector-retrieval route.
# Request a key at https://www.semanticscholar.org/product/api
S2_API_KEY=

# --- Logging (optional) ---
# main.py defaults to WARNING for clean CLI output. Set INFO to see routing
# decisions, including which tools remain bound to the manager after a route
# fails. Requires main.py to use os.environ.setdefault for LOG_LEVEL.
# LOG_LEVEL=INFO